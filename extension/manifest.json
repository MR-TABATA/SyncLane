{
  "manifest_version": 3,
  "name": "SyncLane for Gemini",
  "version": "0.1.0",
  "description": "Gemini(gemini.google.com)の会話を、この Mac の SyncLane アプリにだけ送ります。外部のサーバーには送りません。",
  "host_permissions": ["http://127.0.0.1:47821/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["extract.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
