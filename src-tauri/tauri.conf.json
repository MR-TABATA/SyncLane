{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MrCairn",
  "version": "0.1.0",
  "identifier": "com.mrcairn.app",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MrCairn",
        "width": 1100,
        "height": 760,
        "backgroundColor": "#5d6068",
        "transparent": true,
        "titleBarStyle": "transparent",
        "minWidth": 720,
        "minHeight": 500,
        "center": true,
        "label": "main"
      },
      {
        "label": "search",
        "title": "MrCairn 検索",
        "url": "index.html#search",
        "width": 720,
        "height": 250,
        "minWidth": 600,
        "minHeight": 210,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
