{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SyncLane",
  "version": "0.2.14",
  "identifier": "com.synclane.app",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SyncLane",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 500,
        "center": true,
        "label": "main"
      },
      {
        "label": "search",
        "title": "SyncLane 検索",
        "url": "index.html#search",
        "width": 720,
        "height": 250,
        "minWidth": 600,
        "minHeight": 210,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyNURFQkREMTg5QzMxNDgKUldSSU1ad1kzZXRkc2w2bzB1b2xQeDNBWWNKNnhCcC9ULzBRQlFJeExGWmkwTVIyaGFhaUZlVXcK",
      "endpoints": [
        "https://mrktools.app/downloads/synclane/update.json"
      ]
    }
  }
}
